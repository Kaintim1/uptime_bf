-- Drag on mouse or touch
local dragging, startInput, startFrame
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        startInput = input.Position
        startFrame = frame.Position
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - startInput
        frame.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + d.X, startFrame.Y.Scale, startFrame.Y.Offset + d.Y)
    end
end)

local measuredAge, measuredAt = nil, nil
local busy = false
local function refresh()
    if busy or not gui.Parent then return end
    busy = true
    button.Text = "Kontrol ediliyor..."
    status.Text = "Mevcut sunucu sorgulaniyor..."
    local age = nil
    if game.PlaceId == PLACE_ID and game.JobId ~= "" then
        local body = getBody(AGE_URL .. HttpService:UrlEncode(game.JobId))
        if body then
            local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
            if ok and type(data) == "table" then
                local value = tonumber(data.age or data.Age)
                if value and value >= 0 and value < 315360000 then
                    age = value -- API convention: seconds; requires source accuracy
                end
            end
        end
    end
    if age then
        measuredAge, measuredAt = age, os.clock()
        status.Text = "Kaynak: RoPro API (dogrulanmamis)"
    else
        measuredAge, measuredAt = nil, nil
        uptime.Text = "Sunucu yasi bilinmiyor"
        status.Text = game.PlaceId ~= PLACE_ID and "Bu panel yalnizca Third Sea icindir." or "Yas verisi alinamadi; tahmin yapilmiyor."
    end
    button.Text = "Yeniden kontrol et"
    busy = false
end
button.MouseButton1Click:Connect(function() task.spawn(refresh) end)
task.spawn(refresh)
task.spawn(function()
    while gui.Parent do
        if measuredAge and measuredAt then
            local seconds = math.floor(measuredAge + (os.clock() - measuredAt))
            uptime.Text = string.format("%d dakika\n%d saat %02d dakika", math.floor(seconds / 60), math.floor(seconds / 3600), math.floor(seconds % 3600 / 60))
        end
        task.wait(1)
    end
end)
