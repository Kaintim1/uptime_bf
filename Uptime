-- Blox Fruits Third Sea - Current Server Uptime (no server hopping)
-- External age service is not guaranteed to be available.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local THIRD_SEA_IDS = { [7449423635] = true, [100117331123089] = true }
local currentPlace = game.PlaceId
local currentJob = game.JobId
local player = Players.LocalPlayer
local parentGui = (gethui and gethui()) or (player and player:WaitForChild("PlayerGui"))
if not parentGui then return end
local previous = parentGui:FindFirstChild("BFThirdSeaUptimeOnly")
if previous then previous:Destroy() end
local gui = Instance.new("ScreenGui")
gui.Name = "BFThirdSeaUptimeOnly"
gui.ResetOnSpawn = false
gui.Parent = parentGui
local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(320, 190)
frame.Position = UDim2.new(0.5, -160, 0, 90)
frame.BackgroundColor3 = Color3.fromRGB(19, 20, 28)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
local stroke = Instance.new("UIStroke", frame)
stroke.Color = Color3.fromRGB(255, 175, 25)
stroke.Thickness = 2
local function label(text, y, height, size, color)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Position = UDim2.fromOffset(12, y)
    t.Size = UDim2.new(1, -24, 0, height)
    t.Text = text
    t.TextColor3 = color or Color3.fromRGB(245, 245, 245)
    t.TextSize = size
    t.TextWrapped = true
    t.Font = Enum.Font.GothamBold
    t.Parent = frame
    return t
end
label("Blox Fruits | Third Sea", 10, 26, 16, Color3.fromRGB(255, 190, 65))
local ageLabel = label("Sunucu yasi bilinmiyor", 48, 38, 20)
local statusLabel = label("Kontrol bekleniyor", 92, 39, 12, Color3.fromRGB(190, 190, 200))
local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -24, 0, 36)
button.Position = UDim2.fromOffset(12, 145)
button.BackgroundColor3 = Color3.fromRGB(255, 175, 25)
button.Text = "Yeniden kontrol et"
button.TextColor3 = Color3.fromRGB(20, 20, 25)
button.Font = Enum.Font.GothamBold
button.TextSize = 14
button.Parent = frame
Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
local function httpGet(url)
    local req = (syn and syn.request) or (http and http.request) or request or (fluxus and fluxus.request)
    if req then
        local response = req({Url=url, Method="GET"})
        if response and (response.StatusCode == 200 or response.StatusCode == nil) then
            return response.Body
        end
        return nil
    end
    return HttpService:GetAsync(url)
end
local baseAge, fetchedAt = nil, nil
local busy = false
local function updateDisplay()
    if not gui.Parent then return end
    if baseAge and fetchedAt then
        local seconds = math.max(0, baseAge + (os.clock() - fetchedAt))
        local minutes = math.floor(seconds / 60)
        ageLabel.Text = string.format("%d dakika (%d sa %d dk)", minutes, math.floor(minutes / 60), minutes % 60)
    else
        ageLabel.Text = "Sunucu yasi bilinmiyor"
    end
end
local function refresh()
    if busy then return end
    busy = true
    button.Text = "Kontrol ediliyor..."
    baseAge, fetchedAt = nil, nil
    updateDisplay()
    if not THIRD_SEA_IDS[currentPlace] then
        statusLabel.Text = "Third Sea taninamadi | Place ID: " .. tostring(currentPlace)
    elseif type(currentJob) ~= "string" or currentJob == "" then
        statusLabel.Text = "Sunucu Job ID bulunamadi"
    else
        statusLabel.Text = "Mevcut sunucu yasi sorgulaniyor..."
        local url = "https://api.ropro.io/getServerAge.php?serverId=" .. HttpService:UrlEncode(currentJob)
        local ok, raw = pcall(httpGet, url)
        if ok and type(raw) == "string" then
            local decoded, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if decoded and type(data) == "table" then
                local seconds = tonumber(data.age or data.Age)
                if seconds and seconds >= 0 and seconds < 31536000 then
                    baseAge, fetchedAt = seconds, os.clock()
                    statusLabel.Text = "RoPro verisi (bagimsiz dogrulanmadi) | Place: " .. tostring(currentPlace)
                end
            end
        end
        if not baseAge then
            statusLabel.Text = "Yas verisi alinamadi; baglanti suren gosterilmiyor."
        end
    end
    updateDisplay()
    button.Text = "Yeniden kontrol et"
    busy = false
end
button.MouseButton1Click:Connect(function() task.spawn(refresh) end)
task.spawn(refresh)
task.spawn(function()
    while gui.Parent do
        updateDisplay()
        task.wait(1)
    end
end)
