-- Blox Fruits Third Sea - current server uptime only
-- No server search, hopping or teleportation.
-- Requires an external service returning verified server age for the current JobId.
local PLACE_ID = 7449423635
local AGE_URL = "https://api.ropro.io/getServerAge.php?serverId="
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local function getBody(url)
    local candidates = {
        (syn and syn.request),
        (http and http.request),
        request,
        (fluxus and fluxus.request)
    }
    for _, fn in ipairs(candidates) do
        if type(fn) == "function" then
            local ok, response = pcall(fn, {Url = url, Method = "GET"})
            if ok and type(response) == "table" and response.Success ~= false
                and (not response.StatusCode or response.StatusCode == 200)
                and type(response.Body) == "string" then
                return response.Body
            end
        end
    end
    local ok, body = pcall(function() return HttpService:GetAsync(url, true) end)
    if ok and type(body) == "string" then return body end
    return nil
end

