local function label(text, y, height, size, color)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -20, 0, height)
    t.Position = UDim2.fromOffset(10, y)
    t.BackgroundTransparency = 1
    t.Text = text
    t.TextSize = size
    t.TextColor3 = color
    t.TextWrapped = true
    t.Font = Enum.Font.GothamBold
    t.Parent = frame
    return t
end
